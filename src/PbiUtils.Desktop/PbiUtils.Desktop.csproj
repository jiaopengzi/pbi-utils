<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../../web/public/branding/logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PbiUtils.Windows/PbiUtils.Windows.csproj" />
    <ProjectReference Include="../PbiUtils.Infrastructure/PbiUtils.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <EmbeddedResource Include="../../web/public/branding/logo.ico" LogicalName="PbiUtils.Desktop.logo.ico" />
    <Content Include="../../web/dist/**/*" Condition="'$(IncludePbiFrontend)' != 'false'" Link="web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
