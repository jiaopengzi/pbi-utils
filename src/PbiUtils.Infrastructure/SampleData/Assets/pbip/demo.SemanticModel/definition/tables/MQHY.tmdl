	partition MQHY-b598470c-e1b1-4bb9-b538-02b53078e284 = m
		mode: import
		queryGroup: 基础必备
		source = ```
				let
				
				    dimension = #table
				        (
				        type table
				            [
				                Index=Int64.Type
				                ,MQHY=text
				
				
				            ]
				        ,List.Transform({1..19},(n)=> 
				                    {
				                        n
				                        ,if n<13 then "M"& Number.ToText(n,"00")
				                            else if n<17 then "Q"& Number.ToText(n-12,"0")
				                            else if n<19 then "H"& Number.ToText(n-16,"0")
				                            else "FY"
				                    }
				                        )
				        )
				in
				    dimension
				```

