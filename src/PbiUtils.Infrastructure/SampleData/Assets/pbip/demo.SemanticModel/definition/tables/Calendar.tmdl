	partition Calendar-49f3e331-89a0-4804-b0b1-3dd45f58cbdb = m
		mode: import
		queryGroup: 基础必备
		source = ```
				let
				    date_start=#date(2017, 1, 1),//开始日期
				    date_end=#date(2022, 12, 31),//结束日期
				    count=Duration.Days(date_end-date_start),//间隔天数
				    calendar = #table
				        (
				        type table
				            [
				                dates=date
				                ,year=Int64.Type
				                ,month=Int64.Type
				                ,day=Int64.Type
				                ,year_m=Int64.Type
				                ,quarter=Int64.Type
				                ,year_q=Int64.Type
				                ,weeknumber=Int64.Type
				                ,weekday=Int64.Type
				                ,weekus=text
				                ,weekcn=text
				                ,weekcna=text
				                ,M=text
				                ,YM=text
				                ,Q=text
				                ,YQ=text
				                ,H=text
				                ,YH=text
				                ,FY=text
				                ,FY00=text
				
				            ]
				        ,List.Transform({0..count},(n)=> 
				            let d=Date.AddDays(date_start,n) in 
				                    {
				                        d//日期
				                        ,Date.Year(d)//年
				                        ,Date.Month(d)//月
				                        ,Date.Day(d)//天
				                        ,Date.Year(d)*100+Date.Month(d)//年月组合
				                        ,Date.QuarterOfYear(d)//季度
				                        ,Date.Year(d)*100+Date.QuarterOfYear(d)//年季度组合
				                        ,Date.WeekOfYear(d,1)//周一开始的一年第几周
				                        ,Date.DayOfWeek(d,1)//星期几
				                        ,Date.DayOfWeekName(d, "en-US")//星期几英文
				                        ,Date.DayOfWeekName(d, "zh-CN")//星期几中文
				                        ,Text.End(Date.DayOfWeekName(d, "zh-CN"),1)//星期几简写
				                        ,"M"&Date.ToText(d,"MM")
				                        ,Date.ToText(d,"Yyy")&"M"&Date.ToText(d,"MM")
				                        ,"Q"&Number.ToText(Date.QuarterOfYear(d))
				                        ,Date.ToText(d,"Yyy")&"Q"&Number.ToText(Date.QuarterOfYear(d))
				                        ,if Date.Month(d)<7 then "H1" else "H2"
				                        ,if Date.Month(d)<7 then Date.ToText(d,"Yyy")&"H1" else Date.ToText(d,"Yyy")&"H2"
				                        ,"FY"
				                        ,"FY"&Date.ToText(d,"yy")
				                    }
				                        )
				        )
				in
				    calendar
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = 导航

