<!--
 * FilePath    : pbi-utils\Directory.Build.props
 * Author      : jiaopengzi
 * Blog        : https://jiaopengzi.com
 * Copyright   : Copyright (c) 2026 by jiaopengzi, All Rights Reserved.
 * Description : 集中配置目标框架, 从 version 读取产品数字版本和完整标签, 并启用可空检查与依赖锁定.
-->

<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 编译/可空性/分析器警告必须阻止测试或发布, 不依赖人工读取成功输出中的警告. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- version 记录单行完整标签. SDK 从数字 Version 生成程序集版本与文件版本. -->
    <_PbiVersionPath>$(MSBuildThisFileDirectory)version</_PbiVersionPath>
    <_PbiVersionText Condition="Exists('$(_PbiVersionPath)')">$([System.IO.File]::ReadAllText('$(_PbiVersionPath)'))</_PbiVersionText>
    <_PbiVersionPattern>\A(?&lt;tag&gt;v(?&lt;version&gt;(?&lt;major&gt;0|[1-9][0-9]{0,4})\.(?&lt;minor&gt;0|[1-9][0-9]{0,4})\.(?&lt;patch&gt;0|[1-9][0-9]{0,4}))(?:-(?:alpha|beta|rc)(?&lt;revision&gt;[1-9][0-9]{0,9}))?)(?:\r?\n)?\z</_PbiVersionPattern>
    <_PbiVersionTag>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['tag'].Value)</_PbiVersionTag>
    <_PbiVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['version'].Value)</_PbiVersion>
    <_PbiVersionMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['major'].Value)</_PbiVersionMajor>
    <_PbiVersionMinor>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['minor'].Value)</_PbiVersionMinor>
    <_PbiVersionPatch>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['patch'].Value)</_PbiVersionPatch>
    <_PbiVersionRevision>$([System.Text.RegularExpressions.Regex]::Match('$(_PbiVersionText)', '$(_PbiVersionPattern)').Groups['revision'].Value)</_PbiVersionRevision>
    <Version Condition="'$(_PbiVersion)' != ''">$(_PbiVersion)</Version>
    <PbiReleaseTag Condition="'$(PbiReleaseTag)' == ''">$(_PbiVersionTag)</PbiReleaseTag>
    <!-- Windows 文件属性和程序集描述显示完整标签. SDK 的 AssemblyVersion/FileVersion 仍从数字 Version 生成. -->
    <InformationalVersion Condition="'$(PbiReleaseTag)' != ''">$(PbiReleaseTag)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
