{
    "name": "pbi-utils-web",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": "24.22.2"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5173 --strictPort",
        "build": "pnpm lint && vite build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "pnpm format:check && oxlint --max-warnings 0 . && pnpm lint:templates && pnpm lint:styles && pnpm typecheck",
        "lint:fix": "oxlint --fix --max-warnings 0 . && pnpm lint",
        "lint:templates": "node scripts/check-vue-templates.ts",
        "lint:styles": "node scripts/check-styles.ts",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "test": "pnpm lint && vitest run",
        "test:watch": "pnpm lint && vitest"
    },
    "dependencies": {
        "@codemirror/commands": "6.11.1",
        "@codemirror/lang-markdown": "6.5.2",
        "@codemirror/language": "6.13.1",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@lezer/highlight": "1.2.5",
        "dompurify": "3.4.17",
        "element-plus": "2.14.7",
        "marked": "18.1.1",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "jsdom": "30.1.3",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "playwright": "1.64.1",
        "sass-embedded": "1.106.1",
        "typescript": "6.0.3",
        "unplugin-auto-import": "21.1.0",
        "unplugin-vue-components": "32.1.0",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "vscode-css-languageservice": "6.3.10",
        "vscode-languageserver-textdocument": "1.0.16",
        "vue-tsc": "3.3.13"
    }
}
