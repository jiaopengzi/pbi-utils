		measure 1500_预测_预测达成_单位_ =
				
				VAR DAY_MAX =
				    CALCULATETABLE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL ( '01_Calendar' ) )
				VAR DAY_MIN =
				    CALCULATETABLE (
				        STARTOFYEAR ( '01_Calendar'[dates] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DATE_AC =
				    DATESBETWEEN ( '01_Calendar'[dates], DAY_MIN, DAY_MAX )
				VAR DATE_PRE =
				    DATESBETWEEN (
				        '01_Calendar'[dates],
				        DATEADD ( DAY_MIN, -1, YEAR ),
				        DATEADD ( DAY_MAX, -1, YEAR )
				    )
				VAR YTD_AC =
				    CALCULATE ( [0001_销售金额_单位_D_], DATE_AC )
				VAR YTD_PRE =
				    CALCULATE ( [0001_销售金额_单位_D_], DATE_PRE )
				VAR YOY =
				    DIVIDE ( YTD_AC, YTD_PRE )
				VAR DAY_AC =
				    MAX ( '01_Calendar'[dates] )
				VAR PRE =
				    CALCULATE (
				        [0001_销售金额_单位_D_],
				        DATEADD ( '01_Calendar'[dates], -1, YEAR )
				    )
				RETURN
				    IF ( DAY_AC <= DAY_MAX, BLANK (), PRE * YOY )
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: f1435a79-68fd-4e5a-b5b7-fbcaf787d007

			changedProperty = FormatString

		measure 1501_预测_AC_MTD_单位_ =
				
				VAR DAY_MAX =
				    CALCULATETABLE (
				        LASTDATE ( 'T04_订单主表'[F_03_下单日期] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DAY_AC =
				    LASTDATE ( '01_Calendar'[dates] )
				RETURN
				    IF (
				        DAY_AC > DAY_MAX,
				        BLANK (),
				        CALCULATE ( [0001_销售金额_单位_D_], DATESMTD ( '01_Calendar'[dates] ) )
				    )
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: e050c074-32e2-4615-9820-318ad30f9d39

			changedProperty = FormatString

		measure 1502_预测_AC_MTD_最后端点_单位_ =
				
				VAR DAY_MAX =
				    CALCULATETABLE (
				        LASTDATE ( 'T04_订单主表'[F_03_下单日期] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DAY_AC =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR DATE_EDN =
				    ENDOFMONTH ( '01_Calendar'[dates] )
				RETURN
				    IF (
				        DAY_AC = DAY_MAX
				            && DAY_AC < DATE_EDN,
				        //DAY_AC < DATE_EDN兼容实际月末两个端点（1502，1504）出现。
				        CALCULATE (
				            [0001_销售金额_单位_D_],
				            DATESMTD ( '01_Calendar'[dates] )
				        ),
				        BLANK ()
				    )
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: aaeefab4-5469-4bb4-95b9-b9f2cf1abb8a

			changedProperty = FormatString

		measure 1503_预测_预测达成_MTD_单位_ =
				
				VAR DAY_MAX0 =
				    CALCULATETABLE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL ( '01_Calendar' ) )
				VAR DAY_MAX1 =
				    CALCULATETABLE (
				        LASTDATE ( '01_Calendar'[dates] ),
				        TREATAS ( DAY_MAX0, '01_Calendar'[dates] )
				    ) //由于'T04_订单主表'[F_03_下单日期]最大日期后在无日期，DATEADD后为空，需要转化到'01_Calendar'[dates]
				VAR DAY_MAX2 =
				    DATEADD ( DAY_MAX1, 1, DAY )
				VAR DAY_MIN =
				    CALCULATETABLE (
				        STARTOFMONTH ( '01_Calendar'[dates] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DAY_AC =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR MTD_FORE0 =
				    CALCULATE (
				        [1500_预测_预测达成_单位_],
				        DATESBETWEEN ( '01_Calendar'[dates], DAY_MAX2, DAY_AC )
				    )
				VAR MTD_FORE1 =
				    CALCULATE (
				        [1500_预测_预测达成_单位_],
				        DATESMTD ( '01_Calendar'[dates] )
				    )
				VAR MTD_AC =
				    CALCULATE ( [0001_销售金额_单位_D_], DATESMTD ( '01_Calendar'[dates] ) )
				RETURN
				    SWITCH (
				        TRUE (),
				        DAY_AC >= DAY_MAX0
				            && DAY_MIN > DAY_MAX0, MTD_FORE1,
				        DAY_AC >= DAY_MAX0
				            && DAY_MIN <= DAY_MAX0, MTD_AC + MTD_FORE0,
				        BLANK ()
				    )
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: 46641076-0cc3-4bfc-8dde-b5c107814708

			changedProperty = FormatString

		measure 1504_预测_预测达成_MTD_最后端点_单位_ =
				
				VAR DAY_MAX_M =
				    CALCULATETABLE (
				        LASTDATE ( '01_Calendar'[dates] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DAY_MAX0 =
				    CALCULATETABLE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL ( '01_Calendar' ) )
				VAR DAY_MAX1 =
				    CALCULATETABLE (
				        LASTDATE ( '01_Calendar'[dates] ),
				        TREATAS ( DAY_MAX0, '01_Calendar'[dates] )
				    )
				VAR DAY_MAX2 =
				    DATEADD ( DAY_MAX1, 1, DAY )
				VAR DAY_MIN =
				    CALCULATETABLE (
				        STARTOFMONTH ( '01_Calendar'[dates] ),
				        ALLSELECTED ( '01_Calendar' )
				    )
				VAR DAY_AC =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR MTD_FORE0 =
				    CALCULATE (
				        [1500_预测_预测达成_单位_],
				        DATESBETWEEN ( '01_Calendar'[dates], DAY_MAX2, DAY_AC )
				    )
				VAR MTD_FORE1 =
				    CALCULATE (
				        [1500_预测_预测达成_单位_],
				        DATESMTD ( '01_Calendar'[dates] )
				    )
				VAR MTD_AC =
				    CALCULATE ( [0001_销售金额_单位_D_], DATESMTD ( '01_Calendar'[dates] ) )
				RETURN
				    SWITCH (
				        TRUE (),
				        DAY_AC = DAY_MAX_M
				            && DAY_MIN > DAY_MAX0, MTD_FORE1,
				        DAY_AC = DAY_MAX_M
				            && DAY_MIN <= DAY_MAX0, MTD_AC + MTD_FORE0,
				        BLANK ()
				    )
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: 4310df4a-ed1f-43ea-9949-8b9ced2d0e32

			changedProperty = FormatString

		measure 1505_预测_目标线_单位_ =
				
				CALCULATE (
