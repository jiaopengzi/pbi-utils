		measure 1510_预测_实际&预测_MTD_工具提示_单位_ =
				
				VAR DAY_MAX =
				    CALCULATETABLE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL ( '01_Calendar' ) )
				VAR DAY_AC =
				    LASTDATE ( '01_Calendar'[dates] )
				RETURN
				    IF ( DAY_AC <= DAY_MAX, [1501_预测_AC_MTD_单位_], [1503_预测_预测达成_MTD_单位_] )
