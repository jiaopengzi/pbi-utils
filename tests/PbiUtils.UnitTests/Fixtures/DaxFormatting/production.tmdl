			changedProperty = FormatString

		measure 0700_销售金额_门店矩阵_排名 =
				
				VAR ROW0 =
				    SELECTEDVALUE ( 'T74_ROW'[ROW] ) - 1
				VAR COLUMN0 =
				    SELECTEDVALUE ( T75_COLUMN[COLUMN] )
				VAR RANK0 = ROW0 * 10 + COLUMN0
				VAR T0 =
				    ADDCOLUMNS (
				        ALL ( 'T01_门店表'[F_02_门店名称] ),
				        "@VALUE0", [0001_销售金额_单位_D_]
				    )
				VAR T1 =
				    FILTER ( T0, [@VALUE0] <> BLANK () )
				VAR T2 =
				    ADDCOLUMNS (
				        T1,
				        "@R0",
				            RANKX ( T1, [0001_销售金额_单位_D_],, DESC )
				                + CALCULATE ( SUM ( 'T01_门店表'[F_00_自动编号] ) ) / 1000
				    )
				VAR T3 =
				    ADDCOLUMNS ( T2, "@R1", VAR R = [@R0] RETURN RANKX ( T2, [@R0], R, ASC ) )
				VAR T4 =
				    FILTER ( T3, [@R1] = RANK0 )
				RETURN
				    MAXX ( T4, [@R1] & "-" & [F_02_门店名称] )
			displayFolder: 07_销售金额_门店矩阵
			lineageTag: 74d274fb-aef3-4c8e-90e4-0a4632d00fc8

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0701_销售金额_门店矩阵_门店按照毛利_color_背景 =
				
				/*
				    good:#188818 ; RGB:24,136,24 ; 色阶开始：#CCFFCC , RGB:204,255,204
				    neutral:#DD8800 ; RGB:221,136,0
				    bad:#BB1818 ; RGB:187,24,24；色阶开始：#FFCCCC , RGB:255,204,204
				    字体颜色：#EEEEEE ; RGB:238,238,238
				*/
				VAR ROW0 =
				    SELECTEDVALUE ( 'T74_ROW'[ROW] ) - 1
				VAR COLUMN0 =
				    SELECTEDVALUE ( T75_COLUMN[COLUMN] )
				VAR RANK0 = ROW0 * 10 + COLUMN0
				VAR T0 =
				    ADDCOLUMNS (
				        ALL ( 'T01_门店表'[F_02_门店名称] ),
				        "@VALUE0", [0001_销售金额_单位_D_]
				    )
				VAR T1 =
				    FILTER ( T0, [@VALUE0] <> BLANK () )
				VAR T2 =
				    ADDCOLUMNS (
				        T1,
				        "@R0",
				            RANKX ( T1, [0001_销售金额_单位_D_],, DESC )
				                + CALCULATE ( SUM ( 'T01_门店表'[F_00_自动编号] ) ) / 1000
				    )
				VAR T3 =
				    ADDCOLUMNS ( T2, "@R1", VAR R = [@R0] RETURN RANKX ( T2, [@R0], R, ASC ) )
				VAR T4 =
				    FILTER ( T3, [@R1] = RANK0 )
				VAR MD =
				    MAXX ( T4, [F_02_门店名称] )
				VAR FILTER0 =
				    TREATAS ( { MD }, 'T01_门店表'[F_02_门店名称] )
				VAR VALUE_MD =
				    CALCULATE ( [0006_毛利率_%_D_], KEEPFILTERS ( FILTER0 ) )
				VAR VALUE_TABLE_0 =
				    CALCULATETABLE ( 'T01_门店表', ALL ( 'T01_门店表'[F_01_门店编号], 'T01_门店表'[F_02_门店名称] ) )
				VAR VALUE_TABLE_1 =
				    SUMMARIZE (
				        VALUE_TABLE_0,
				        'T01_门店表'[F_02_门店名称],
				        "@ML", [0006_毛利率_%_D_]
				    )
				VAR VALUE_MD_MAX =
				    MAXX ( VALUE_TABLE_1, [@ML] )
				VAR VALUE_MD_0 = 0
				VAR VALUE_MD_MIN =
				    MINX ( VALUE_TABLE_1, [@ML] )
				VAR VALUE_DIFF_MAX_0 = ( VALUE_MD_MAX - VALUE_MD_0 ) //0是最浅颜色，max是最深good颜色。
				VAR VALUE_DIFF_MIN_0 = ( VALUE_MD_MIN - VALUE_MD_0 ) //0是最浅颜色，MIN是最深bad颜色；0包含在bad中。
				VAR VALUE_DIFF_MD_POSITIVE = ( VALUE_MD_MAX - VALUE_MD ) //正数=>positive
				VAR VALUE_DIFF_MD_NEGATIVE = ( VALUE_MD_MIN - VALUE_MD ) //负数=>negative
				VAR X =
				    IF (
				        VALUE_MD > 0,
				        VALUE_DIFF_MD_POSITIVE / VALUE_DIFF_MAX_0,
				        VALUE_DIFF_MD_NEGATIVE / VALUE_DIFF_MIN_0
				    ) --------------------------------
				//good:#188818 ; RGB:24,136,24 ; 色阶开始：#CCFFCC , RGB:204,255,204
				VAR R_GOOD =
				    INT ( 180 * X ) + 24 //204-24=180
				VAR G_GOOD =
				    INT ( 119 * X ) + 136 //255-136=119
				VAR B_GOOD =
				    INT ( 180 * X ) + 24 //204-24=180
				--------------------------------
				--------------------------------
				//bad:#BB1818 ; RGB:187,24,24；色阶开始：#FFCCCC , RGB:255,204,204
				VAR R_BAD =
				    INT ( 68 * X ) + 187 //255-187=68
				VAR G_BAD =
				    INT ( 180 * X ) + 24 //204-24=180
				VAR B_BAD =
				    INT ( 180 * X ) + 24 //204-24=180
				--------------------------------
				VAR R =
				    IF ( VALUE_MD > 0, R_GOOD, R_BAD )
				VAR G =
				    IF ( VALUE_MD > 0, G_GOOD, G_BAD )
				VAR B =
				    IF ( VALUE_MD > 0, B_GOOD, B_BAD )
				VAR D = ","
				VAR TF =
				    VALUE_MD = BLANK ()
				RETURN
				    IF ( TF, "#dddddd", "RGB(" & R & D & G & D & B & ")" )
			displayFolder: 07_销售金额_门店矩阵
			lineageTag: 8f968821-899f-450c-a46e-46b5a0a1c9c3

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0702_销售金额_门店矩阵_门店按照毛利_color_字体 =
				
				"#CCCCCC"
				/*
				    good:#188818 ; RGB:24,136,24 ; 色阶开始：#CCFFCC , RGB:204,255,204
				    neutral:#DD8800 ; RGB:221,136,0
				    bad:#BB1818 ; RGB:187,24,24；色阶开始：#FFCCCC , RGB:255,204,204
				    字体颜色：#EEEEEE ; RGB:238,238,238
				*/
			displayFolder: 07_销售金额_门店矩阵
			lineageTag: b466d4f7-7f7c-4af1-b64e-01afc93757ac

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0800_产品数量_库存_期初_单位_ =
				
				VAR DATE_START0 =
				    CALCULATE ( FIRSTDATE ( '01_Calendar'[dates] ), ALL ( '01_Calendar' ) )
				VAR DATE_END0 =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR TF0 =
				    HASONEVALUE ( '01_Calendar'[dates] ) //日
				VAR TF1 =
				    HASONEVALUE ( '01_Calendar'[YW] ) //周
				VAR TF2 =
				    HASONEVALUE ( '01_Calendar'[YM] ) //月
				VAR TF3 =
				    HASONEVALUE ( '01_Calendar'[YQ] ) //季度
				VAR TF4 =
				    HASONEVALUE ( '01_Calendar'[YH] ) //半年度
				VAR TF5 =
				    HASONEVALUE ( '01_Calendar'[FY00] ) //年度
				VAR N0 =
				    SWITCH (
				        TRUE (),
				        TF0, 0,
				        TF1,
				            DATEDIFF (
				                FIRSTDATE ( '01_Calendar'[StartOfWeek] ),
				                LASTDATE ( '01_Calendar'[EndOfWeek] ),
				                DAY
				            ),
				        TF2,
				            DATEDIFF (
				                FIRSTDATE ( '01_Calendar'[StartOfMonth] ),
				                LASTDATE ( '01_Calendar'[EndOfMonth] ),
				                DAY
				            ),
				        TF3,
				            DATEDIFF (
				                FIRSTDATE ( '01_Calendar'[StartOfQuarter] ),
				                LASTDATE ( '01_Calendar'[EndOfQuarter] ),
				                DAY
				            ),
				        TF4,
				            DATEDIFF (
				                FIRSTDATE ( '01_Calendar'[StartOfHalfYear] ),
				                LASTDATE ( '01_Calendar'[EndOfHalfYear] ),
				                DAY
				            ),
				        TF5,
				            DATEDIFF (
				                FIRSTDATE ( '01_Calendar'[StartOfYear] ),
				                LASTDATE ( '01_Calendar'[EndOfYear] ),
				                DAY
				            ),
				        0
				    ) + 1
				VAR DATE_END1 =
				    SWITCH (
				        TRUE (),
				        TF0, DATEADD ( DATE_END0, - N0, DAY ),
				        TF1, DATEADD ( LASTDATE ( '01_Calendar'[EndOfWeek] ), - N0, DAY ),
				        TF2, DATEADD ( LASTDATE ( '01_Calendar'[EndOfMonth] ), - N0, DAY ),
				        TF3, DATEADD ( LASTDATE ( '01_Calendar'[EndOfQuarter] ), - N0, DAY ),
				        TF4, DATEADD ( LASTDATE ( '01_Calendar'[EndOfHalfYear] ), - N0, DAY ),
				        TF5, DATEADD ( LASTDATE ( '01_Calendar'[EndOfYear] ), - N0, DAY ),
				        DATE_START0 //无筛选的时，默认日期表期初。
				    )
				VAR DATE_END2 =
				    IF ( ISBLANK ( DATE_END1 ), DATE_START0, DATE_END1 ) //兼容dateadd后的空值，注意日期表的两个端点。
				VAR DATE_TABLE0 =
				    DATESBETWEEN ( '01_Calendar'[dates], DATE_START0, DATE_END2 )
				VAR IN0 =
				    CALCULATE ( [0018_产品数量_入库_单位_D_], DATE_TABLE0 )
				VAR OUT0 =
				    CALCULATE ( [0019_产品数量_出库_单位_D_], DATE_TABLE0 )
				VAR DATE_START_ABS0 =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_04_送货日期] ), ALL () ) //兼容显示到事实表最后日期。
				RETURN
				    IN0 - OUT0
				//IF ( DATE_START_ABS0 >= DATE_END2, IN0 - OUT0, BLANK () )
			formatString: #,0
			displayFolder: 08_产品数量_库存
			lineageTag: 80d72c72-e334-490b-87ca-59c2ffa388b8

			changedProperty = FormatString

		measure 0801_产品数量_库存_期末_单位_ =
				
				VAR DATE_START0 =
				    CALCULATE ( FIRSTDATE ( '01_Calendar'[dates] ), ALL ( '01_Calendar' ) )
				VAR DATE_END0 =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR DATE_TABLE0 =
				    DATESBETWEEN ( '01_Calendar'[dates], DATE_START0, DATE_END0 )
				VAR IN0 =
				    CALCULATE ( [0018_产品数量_入库_单位_D_], DATE_TABLE0 )
				VAR OUT0 =
				    CALCULATE ( [0019_产品数量_出库_单位_D_], DATE_TABLE0 )
				VAR DATE_START_ABS0 =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_04_送货日期] ), ALL () ) //兼容显示到事实表最后日期。
				RETURN
				    IN0 - OUT0
				//IF(DATE_START_ABS0>=DATE_END0,IN0 - OUT0,BLANK())
			formatString: #,0
			displayFolder: 08_产品数量_库存
			lineageTag: 245925b2-2ea9-4c6c-87f0-367e1bd031c6

			changedProperty = FormatString

		measure 0802_产品数量_库存_期间平均库存_单位_ = ```
				
				/*
				----------------------------------------------------------------------------------------------------
				存货周转天数（Days Sales Of Inventory），参考值=>年度：120;半年：60;季度：30;月度：9;周度：2;单日：1。
				存货周转率（Inventory Turnover），越大表示周转越快。
				----------------------------------------------------------------------------------------------------
				年度：N = 360
				半年：N = 180
				季度：N = 90
				月度：N = 30
				周度：N = 7
				单日: N = 1
				----------------------------------------------------------------------------------------------------
				库存周转天数 = N / 期间存货周转率
				库存周转率 = 期间出库数量 / 期间平均库存 
				期间平均库存 =（ 期初库存 + 期末库存）÷ 2
				----------------------------------------------------------------------------------------------------
				*/
				//1、期初期末平均法
				( [0800_产品数量_库存_期初_单位_] + [0801_产品数量_库存_期末_单位_] ) / 2
				//2、日平均法
				// VAR T0 =
				//     SUMMARIZE ( '01_Calendar', '01_Calendar'[dates] )
				// VAR T1 =
				//     ADDCOLUMNS ( T0, "@KC", [0801_产品数量_库存_期末_单位_D_] )
				// VAR FM =
				//     COUNTROWS ( T0 )
				// VAR FZ =
				//     SUMX ( T1, [@KC] )
				// RETURN
				//     DIVIDE ( FZ, FM, BLANK () )
				```
			formatString: #,0
			displayFolder: 08_产品数量_库存
			lineageTag: 5e8e29ec-6071-4b2b-99b6-a8ae79213b82

			changedProperty = FormatString

		measure 0803_产品数量_库存_期间周转率_单位_ = ```
				
				/*
				----------------------------------------------------------------------------------------------------
				存货周转天数（Days Sales Of Inventory），参考值=>年度：120;半年：60;季度：30;月度：9;周度：2;单日：1。
				存货周转率（Inventory Turnover），越大表示周转越快。
				----------------------------------------------------------------------------------------------------
				年度：N = 360
				半年：N = 180
				季度：N = 90
				月度：N = 30
				周度：N = 7
				单日: N = 1
				----------------------------------------------------------------------------------------------------
				库存周转天数 = N / 期间存货周转率
				库存周转率 = 期间出库数量 / 期间平均库存 
				期间平均库存 =（ 期初库存 + 期末库存）÷ 2
				----------------------------------------------------------------------------------------------------
				*/
				VAR FM = ( [0800_产品数量_库存_期初_单位_] + [0801_产品数量_库存_期末_单位_] ) / 2
				VAR FZ = [0019_产品数量_出库_单位_D_]
				VAR InventoryTurnover =
				    DIVIDE ( FZ, FM, BLANK () )
				RETURN
				    InventoryTurnover
				```
			formatString: #,0.0
			displayFolder: 08_产品数量_库存
			lineageTag: 18100668-16bc-483c-87e1-1a7bf702e601

			changedProperty = FormatString

		measure 0804_产品数量_库存_期间周转天数_单位_ = ```
				
				/*
				----------------------------------------------------------------------------------------------------
				存货周转天数（Days Sales Of Inventory），参考值=>年度：120;半年：60;季度：30;月度：9;周度：2;单日：1。
				存货周转率（Inventory Turnover），越大表示周转越快。
				----------------------------------------------------------------------------------------------------
				年度：N = 360
				半年：N = 180
				季度：N = 90
				月度：N = 30
				周度：N = 7
				单日: N = 1
				----------------------------------------------------------------------------------------------------
				库存周转天数 = N / 期间存货周转率
				库存周转率 = 期间出库数量 / 期间平均库存 
				期间平均库存 =（ 期初库存 + 期末库存）÷ 2
				----------------------------------------------------------------------------------------------------
				*/
				VAR TF0 =
				    HASONEVALUE ( '01_Calendar'[dates] ) //日
				VAR TF1 =
				    HASONEVALUE ( '01_Calendar'[YW] ) //周
				VAR TF2 =
				    HASONEVALUE ( '01_Calendar'[YM] ) //月
				VAR TF3 =
				    HASONEVALUE ( '01_Calendar'[YQ] ) //季度
				VAR TF4 =
				    HASONEVALUE ( '01_Calendar'[YH] ) //半年度
				VAR TF5 =
				    HASONEVALUE ( '01_Calendar'[FY00] ) //年度
				VAR N =
				    SWITCH (
				        TRUE (),
				        TF0, 1,
				        TF1, 7,
				        TF2, 30,
				        TF3, 90,
				        TF4, 180,
				        TF5, 360,
				        COUNTROWS ( '01_Calendar' )
				    )
				VAR DaysSalesOfInventory =
				    DIVIDE ( N, [0803_产品数量_库存_期间周转率_单位_] )
				RETURN
				    DaysSalesOfInventory
				```
			formatString: #,0
			displayFolder: 08_产品数量_库存
			lineageTag: e5864bbd-fdab-4eb5-b31a-43876e710357

