createOrReplace

	ref table 00_Measure

		measure 0000_刷新时间 =
				
				SELECTEDVALUE ( '04_RefreshTime'[RefreshTime] )
			displayFolder: 00_基础度量值
			lineageTag: 5426aa1e-70f4-4839-b39a-20053f127ba6

		measure 0001_销售金额_单位_D_ =
				
				SUM ( 'T05_订单子表'[F_06_产品销售金额] )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: a865d0c9-3112-45bf-8506-139a16a60917

			annotation PBI_FormatHint = {"isDecimal":true}

		measure 0002_订单数量_单位_D_ =
				
				COUNTROWS ( 'T04_订单主表' )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 8c2c6d13-bd87-4220-8df4-970c0af1ca2d

		measure 0003_销售目标_单位_D_ =
				
				SUM ( 'T06_销售目标表'[F_04_每日目标] )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 997425b1-2c47-4fdf-944a-3607b956c56c

			annotation PBI_FormatHint = {"isDecimal":true}

		measure 0004_产品成本金额_单位_D_ =
				
				SUMX (
				    'T05_订单子表',
				    RELATED ( 'T00_产品表'[F_05_产品成本价格] ) * 'T05_订单子表'[F_05_产品销售数量]
				)
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 618ba262-a820-4ba8-8114-45f4d8ca0dac

			annotation PBI_FormatHint = {"isDecimal":true}

		measure 0005_毛利_单位_D_ =
				
				[0001_销售金额_单位_D_] - [0004_产品成本金额_单位_D_]
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 704fed73-6e07-4a21-94cd-25be5f874325

			annotation PBI_FormatHint = {"isDecimal":true}

		measure 0006_毛利率_%_D_ =
				
				DIVIDE ( [0005_毛利_单位_D_], [0001_销售金额_单位_D_], BLANK () )
			formatString: 0.00%;-0.00%;0.00%
			displayFolder: 00_基础度量值
			lineageTag: 1c069c77-cbe7-4574-ba66-8a77eaf97710

			changedProperty = FormatString

		measure 0007_目标完成率_%_D_ =
				
				DIVIDE ( [0001_销售金额_单位_D_], [0003_销售目标_单位_D_] )
			formatString: 0.00%;-0.00%;0.00%
			displayFolder: 00_基础度量值
			lineageTag: 9659005c-adae-4a9b-a5b2-ae13dfeff34a

			changedProperty = FormatString

		measure 0008_产品数量_单位_D_ =
				
				CALCULATE ( COUNTROWS ( 'T00_产品表' ), KEEPFILTERS ( 'T05_订单子表' ) )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 30ee9582-778e-47ac-b460-206992a6ec79

		measure 0009_门店数量_单位_D_ =
				
				VAR DATE_AC_A =
				    LASTDATE ( '01_Calendar'[dates] )
				VAR TABLE_OPEN =
				    FILTER ( 'T01_门店表', 'T01_门店表'[F_04_开店日期] <= DATE_AC_A )
				VAR TABLE_CLOSE =
				    FILTER ( TABLE_OPEN, [F_09_关店日期] > DATE_AC_A || [F_09_关店日期] = BLANK () )
				RETURN
				    COUNTROWS ( TABLE_CLOSE )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: b537a112-a17f-415f-b458-19eb19157ead

		measure 0010_客户数量_已购买_订单日期_单位_D_ =
				
				CALCULATE (
				    COUNTROWS ( 'T02_客户表' ),
				    KEEPFILTERS ( 'T04_订单主表' ),
				    KEEPFILTERS ( 'T05_订单子表' )
				)
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 917d263c-5423-4a7f-ae81-9b7ff0be3ec5

		measure 0011_大区_idphotoURL =
				
				VAR U = "https://demo.jiaopengzi.com/idphoto/"
				VAR R =
				    SELECTEDVALUE ( 'D00_大区表'[F_01_大区ID] )
				VAR L = ".png"
				RETURN
				    IF ( HASONEVALUE ( 'D00_大区表'[F_03_大区负责人] ), U & R & L, BLANK () )
			displayFolder: 00_基础度量值
			lineageTag: a380b88f-6417-4c5d-96f9-2cb739a86305
			dataCategory: ImageUrl

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0012_大区_负责人 =
				
				SELECTEDVALUE ( 'D00_大区表'[F_03_大区负责人] )
			displayFolder: 00_基础度量值
			lineageTag: e388c30a-2d84-433d-abd9-c39e13d4b0e0

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0013_大区 =
				
				SELECTEDVALUE ( 'D00_大区表'[F_02_大区] )
			displayFolder: 00_基础度量值
			lineageTag: 1021c2b2-ceee-4563-89fb-6f0f2a3adb62

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0014_省简称 =
				
				VAR TF0 =
				    HASONEFILTER ( 'D01_省份表'[F_04_省简称] )
				VAR TF1 =
				    HASONEFILTER ( 'D01_省份表_对比'[F_04_省简称] )
				VAR R0 =
				    SELECTEDVALUE ( 'D01_省份表'[F_04_省简称] )
				VAR R1 =
				    COUNTROWS ( 'D01_省份表' )
				VAR R_DB0 =
				    SELECTEDVALUE ( 'D01_省份表_对比'[F_04_省简称] )
				VAR R_DB1 =
				    COUNTROWS ( 'D01_省份表_对比' )
				VAR D =
				    SELECTEDVALUE ( 'G02_P50_AB对比分析'[对比维度] )
				RETURN
				    SWITCH (
				        TRUE (),
				        D = "A"
				            && TF0 = TRUE (), R0,
				        D = "A"
				            && TF0 = FALSE (), "省：" & R1,
				        D = "B"
				            && TF1 = TRUE (), R_DB0,
				        D = "B"
				            && TF1 = FALSE (), "省：" & R_DB1,
				        R0
				    )
			displayFolder: 00_基础度量值
			lineageTag: cadc4d5c-e8e8-472a-aa9e-875a758e8376

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0015_折扣比例_%_D_ =
				
				VAR FZ = [0001_销售金额_单位_D_]
				VAR FM =
				    SUMX ( 'T05_订单子表', 'T05_订单子表'[F_03_产品销售价格] * 'T05_订单子表'[F_05_产品销售数量] )
				RETURN
				    DIVIDE ( FZ, FM, BLANK () )
			formatString: 0%;-0%;0%
			displayFolder: 00_基础度量值
			lineageTag: ef2349da-e617-462d-8dfa-1403733a295d

			changedProperty = FormatString

		measure 0016_订单件数_单位_D_ =
				
				SUM ( 'T05_订单子表'[F_05_产品销售数量] )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: d06e89ce-5ee7-403a-b8be-b3a0288d6e64

			changedProperty = FormatString

		measure 0017_销售金额_门店占比_%_D_ =
				
				VAR FZ = [0001_销售金额_单位_D_]
				VAR FM =
				    CALCULATE (
				        [0001_销售金额_单位_D_],
				        ALL ( 'T01_门店表'[F_02_门店名称], 'T01_门店表'[F_00_自动编号] )
				    )
				RETURN
				    DIVIDE ( FZ, FM, BLANK () )
			displayFolder: 00_基础度量值
			lineageTag: eb5b3795-d3d7-4ec4-b651-b5e5d2538caa

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0018_产品数量_入库_单位_D_ =
				
				SUM ( 'T03_入库信息表'[F_02_入库产品数量] )
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: eb5deb39-dc19-4f46-9bf6-106607652d32

			changedProperty = FormatString

		measure 0019_产品数量_出库_单位_D_ =
				
				CALCULATE (
				    SUM ( 'T05_订单子表'[F_05_产品销售数量] ),
				    USERELATIONSHIP ( 'T04_订单主表'[F_04_送货日期], '01_Calendar'[dates] )
				)
			formatString: #,0
			displayFolder: 00_基础度量值
			lineageTag: 1a6197e8-fd93-47a6-b46c-406e53dd45b9

			changedProperty = FormatString

		measure 0100_日期矩阵_DAY =
				
				SELECTEDVALUE ( '01_Calendar'[day] )
			formatString: 0
			displayFolder: 01_日期矩阵_日历热力图
			lineageTag: 672a1f91-2db2-419e-b42b-ecee8a7c1eb2

			changedProperty = FormatString

		measure 0101_日期矩阵_DAY_color_map =
				
				VAR VALUE_DAY = [0001_销售金额_单位_D_]
				VAR VALUE_TABLE_0 =
				    CALCULATETABLE (
				        '01_Calendar',
				        ALL (
				            '01_Calendar'[dates],
				            '01_Calendar'[day],
				            '01_Calendar'[weeknumber],
				            '01_Calendar'[weekday],
				            '01_Calendar'[weekcna] //易错点：注意清除筛选的时候，按列排序的列都要加上；weekcna按照weekday排序的。
				        )
				    )
				VAR VALUE_TABLE_1 =
				    SUMMARIZE (
				        VALUE_TABLE_0,
				        '01_Calendar'[day],
				        "@DAY", [0001_销售金额_单位_D_]
				    )
				VAR VALUE_DAY_MAX =
				    MAXX ( VALUE_TABLE_1, [@DAY] )
				VAR VALUE_DAY_MIN =
				    MINX ( VALUE_TABLE_1, [@DAY] )
				VAR VALUE_DIFF_MAX = ( VALUE_DAY_MAX - VALUE_DAY_MIN ) //min是最浅颜色，max是最深颜色。
				VAR VALUE_DIFF_DAY = ( VALUE_DAY_MAX - VALUE_DAY )
				VAR X = VALUE_DIFF_DAY / VALUE_DIFF_MAX
				VAR R =
				    INT ( 200 * X ) + 20
				VAR G =
				    INT ( 100 * X ) + 140 //222,239
				VAR B = 250
				VAR D = ","
				VAR TF =
				    VALUE_DAY = BLANK ()
				RETURN
				    IF ( TF, "#dddddd", "RGB(" & R & D & G & D & B & ")" )
			displayFolder: 01_日期矩阵_日历热力图
			lineageTag: 1a01c7e0-62d6-4a83-bf58-d120ba435d4f

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0200_计算组矩阵_color_背景 =
				
				/*
				    good:#188818
				    neutral:#DD8800
				    bad:#BB1818
				    1、YTD>=1,MTD>=1 =>good
				    2、YTD>=1,MTD< 1 =>neutral
				    3、YTD< 1,MTD>=1 =>neutral
				    4、YTD< 1,MTD< 1=>bad
				*/
				VAR MTD0 =
				    VAR DATE_END_AC =
				        LASTDATE ( '01_Calendar'[dates] )
				    VAR DATE_SATRT_AC =
				        STARTOFMONTH ( DATE_END_AC )
				    VAR DATE_TABLE_AC =
				        DATESBETWEEN ( '01_Calendar'[dates], DATE_SATRT_AC, DATE_END_AC )
				    RETURN
				        CALCULATE ( [0007_目标完成率_%_D_], DATE_TABLE_AC )
				VAR YTD0 =
				    VAR DATE_END_AC =
				        LASTDATE ( '01_Calendar'[dates] )
				    VAR DATE_SATRT_AC =
				        STARTOFYEAR ( DATE_END_AC )
				    VAR DATE_TABLE_AC =
				        DATESBETWEEN ( '01_Calendar'[dates], DATE_SATRT_AC, DATE_END_AC )
				    RETURN
				        CALCULATE ( [0007_目标完成率_%_D_], DATE_TABLE_AC )
				VAR COLOR0 =
				    SWITCH (
				        TRUE (),
				        YTD0 >= 1
				            && MTD0 >= 1, "#188818",
				        YTD0 >= 1
				            && MTD0 < 1, "#DD8800",
				        YTD0 < 1
				            && MTD0 >= 1, "#DD8800",
				        YTD0 < 1
				            && MTD0 < 1, "#BB1818"
				    )
				VAR LIST0 = { "AC", "MTD", "YTD" }
				VAR ROW_VALUE =
				    SELECTEDVALUE ( 'G03_P60_DWMQHY'[F_07_指标] )
				VAR COLOR_AC_TF =
				    IF ( ROW_VALUE IN LIST0, COLOR0, BLANK () )
				RETURN
				    COLOR_AC_TF
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 12230955-2de1-4b33-90cd-c371a217c0cf

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0201_计算组矩阵_color_字体 =
				
				/*
				    good:#188818
				    neutral:#DD8800
				    bad:#BB1818
				    字体颜色：#EEEEEE
				*/
				VAR LIST0 = { "AC", "MTD", "YTD" }
				VAR ROW_VALUE =
				    SELECTEDVALUE ( 'G03_P60_DWMQHY'[F_07_指标] )
				VAR COLOR_AC_TF =
				    IF ( ROW_VALUE IN LIST0, "#EEEEEE", BLANK () )
				RETURN
				    COLOR_AC_TF
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: dc9a9cb0-97e0-4bfe-8b30-04f07c5de488

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0202_计算组矩阵_工具提示_01_指标 =
				
				SELECTEDVALUE ( 'G03_P60_DWMQHY'[F_07_指标] )
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 30a6d982-ab88-4cfe-9ca8-cd8ddc6f4bf1

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0203_计算组矩阵_工具提示_02_开始日期 =
				
				"开始日期"
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 315d36b9-7f15-49d4-a8b1-c9bbcb506ff7

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0204_计算组矩阵_工具提示_03_结束日期 =
				
				"结束日期"
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 900643ac-4309-473d-a0d1-4fa14a465097

