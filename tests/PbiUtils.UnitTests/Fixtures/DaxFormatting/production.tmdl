			changedProperty = FormatString

		measure 1512_预测_整月_同环比及目标完成率_ =
				
				//用最后一天的MTD
				VAR DATE_START_MONTH_AC =
				    STARTOFMONTH ( '01_Calendar'[dates] ) //兼容闰月及月份天数不一致。
				VAR DATE_END_MONTH_LASTYEAR =
				    ENDOFMONTH ( DATEADD ( DATE_START_MONTH_AC, -1, YEAR ) )
				VAR DATE_END_MONTH_LAST =
				    ENDOFMONTH ( DATEADD ( DATE_START_MONTH_AC, -1, MONTH ) )
				VAR FZ = [1510_预测_实际&预测_MTD_工具提示_单位_]
				VAR FM_YOY =
				    CALCULATE ( [1510_预测_实际&预测_MTD_工具提示_单位_], DATE_END_MONTH_LASTYEAR )
				VAR FM_MOM =
				    CALCULATE ( [1510_预测_实际&预测_MTD_工具提示_单位_], DATE_END_MONTH_LAST )
				VAR _YOY =
				    DIVIDE ( FZ, FM_YOY, BLANK () ) - 1
				VAR _MOM =
				    DIVIDE ( FZ, FM_MOM, BLANK () ) - 1
				VAR _TARGET = [1511_预测_目标完成_单位_%_]
				VAR YM =
				    FORMAT ( DATE_START_MONTH_AC, "YYYY年MM月" )
				RETURN
				    YM & " 同比去年："
				        & FORMAT ( _YOY, "0.0%" ) & "，环比上月："
				        & FORMAT ( _MOM, "0.0%" ) & "，目标完成率："
				        & FORMAT ( _TARGET, "0.0%" ) & "。"
			displayFolder: 15_预测
			lineageTag: fe821bb5-98e7-4031-9357-a9720f10e218

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 1513_预测_MTD_Y轴结束_单位_ =
				
				VAR DATE_ALLSELECTED =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALLSELECTED () )
				VAR DATE_ALL =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL () )
				VAR DATE_MAX =
				    ENDOFMONTH ( '01_Calendar'[dates] )
				VAR DATE0 =
				    IF ( DATE_MAX > DATE_ALL, DATE_ALL, DATE_ALLSELECTED ) //兼容大约当月预测。
				VAR FM = 60
				VAR DATETABLE0 =
				    DATESINPERIOD ( '01_Calendar'[dates], DATE0, - FM, DAY )
				VAR FZ =
				    CALCULATE ( [0001_销售金额_单位_D_], DATETABLE0 )
				RETURN
				    DIVIDE ( FZ, FM ) * FM
			formatString: #,0
			displayFolder: 15_预测
			lineageTag: be481aee-5bd2-4a77-9007-f5461480675e

			changedProperty = FormatString

		measure 1514_预测_AC_Y轴结束_单位_ =
				
				VAR DATE_ALLSELECTED =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALLSELECTED () )
				VAR DATE_ALL =
				    CALCULATE ( LASTDATE ( 'T04_订单主表'[F_03_下单日期] ), ALL () )
				VAR DATE_MAX =
				    ENDOFMONTH ( '01_Calendar'[dates] )
				VAR DATE0 =
				    IF ( DATE_MAX > DATE_ALL, DATE_ALL, DATE_ALLSELECTED )
				VAR FM = 60
				VAR DATETABLE0 =
				    DATESINPERIOD ( '01_Calendar'[dates], DATE0, - FM, DAY )
				VAR FZ =
				    CALCULATE ( [0001_销售金额_单位_D_], DATETABLE0 )
				RETURN
				    DIVIDE ( FZ, FM ) * 10
			formatString: #,0
