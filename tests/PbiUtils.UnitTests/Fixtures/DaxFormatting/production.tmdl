		measure 0205_计算组矩阵_工具提示_04_指标说明 =
				
				SELECTEDVALUE ( 'G03_P60_DWMQHY'[F_08_说明] )
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 365fd1a6-3fec-460f-9551-b3d55afa62ab

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0206_计算组矩阵_工具提示_05_页面说明 =
				
				50
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: 30afc207-068c-42d8-b160-c3226beb3c93

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0207_计算组矩阵_工具提示_06_各省大区内排名 =
				
				VAR DQ =
				    SELECTEDVALUE ( 'D00_大区表'[F_01_大区ID] )
				VAR TABLE0 =
				    ADDCOLUMNS ( ALL ( 'D01_省份表' ), "@销售额", [0001_销售金额_单位_D_] )
				VAR TABLE1 =
				    FILTER ( TABLE0, [F_01_大区ID] = DQ )
				VAR TABLE2 =
				    ADDCOLUMNS (
				        TABLE1,
				        "@RANK", RANKX ( TABLE1, [0001_销售金额_单位_D_], [@销售额], DESC )
				    )
				VAR N =
				    SUM ( 'T71_大区_排名辅助'[ID] )
				VAR TABLE3 =
				    FILTER ( TABLE2, [@RANK] = N )
				RETURN
				    CALCULATE ( MAXX ( TABLE3, [F_04_省简称] ), ALL ( 'D00_大区表' ) )
			displayFolder: 02_计算组矩阵_时间智能
			lineageTag: a5c0ccf4-6459-4db3-a8ac-c13cf49d521d

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0300_销售金额_贡献_组织_省简称_% =
				
				VAR FZ = [0001_销售金额_单位_D_]
				VAR FM =
				    CALCULATE (
				        [0001_销售金额_单位_D_],
				        ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] )
				    )
				VAR P =
				    DIVIDE ( FZ, FM, BLANK () )
				RETURN
				    P
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: 03_销售金额_贡献_组织
			lineageTag: 7b7b5e9c-be88-4e7c-bd54-7849ab24eefc

			changedProperty = FormatString

		measure 0301_销售金额_贡献_组织_省简称_累计_% =
				
				VAR R =
				    RANKX (
				        ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				        [0001_销售金额_单位_D_],
				        ,
				        DESC
				    )
				        + CALCULATE ( SUM ( 'D01_省份表'[F_02_省ID] ) ) / 100
				VAR T =
				    ADDCOLUMNS (
				        ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				        "R",
				            RANKX (
				                ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				                [0001_销售金额_单位_D_],
				                ,
				                DESC
				            )
				                + CALCULATE ( SUM ( 'D01_省份表'[F_02_省ID] ) ) / 100
				    )
				VAR LJ =
				    CALCULATE ( [0001_销售金额_单位_D_], FILTER ( T, [R] <= R ) )
				VAR FM =
				    CALCULATE (
				        [0001_销售金额_单位_D_],
				        ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] )
				    )
				VAR P =
				    DIVIDE ( LJ, FM, BLANK () )
				RETURN
				    P
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: 03_销售金额_贡献_组织
			lineageTag: 7e970f83-e364-4789-9717-0a001d7578f0

			changedProperty = FormatString

		measure 0302_销售金额_贡献_组织_省简称_累计_二八分界_% =
				
				VAR T0 =
				    ADDCOLUMNS (
				        ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				        "R",
				            RANKX (
				                ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				                [0001_销售金额_单位_D_],
				                ,
				                DESC
				            )
				                + CALCULATE ( SUM ( 'D01_省份表'[F_02_省ID] ) ) / 100
				    )
				VAR T1 =
				    ADDCOLUMNS (
				        T0,
				        "@P%",
				            VAR R =
				                RANKX (
				                    ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] ),
				                    [0001_销售金额_单位_D_],
				                    ,
				                    DESC
				                )
				                    + CALCULATE ( SUM ( 'D01_省份表'[F_02_省ID] ) ) / 100
				            VAR LJ =
				                CALCULATE ( [0001_销售金额_单位_D_], FILTER ( T0, [R] <= R ) )
				            VAR FM =
				                CALCULATE (
				                    [0001_销售金额_单位_D_],
				                    ALL ( 'D01_省份表'[F_04_省简称], 'D01_省份表'[F_02_省ID] )
				                )
				            VAR P =
				                DIVIDE ( LJ, FM, BLANK () )
				            RETURN
				                P
				    )
				VAR T2 =
				    FILTER ( T1, [@P%] >= 0.8 )
				VAR MINRANK =
				    MINX ( T2, [@P%] )
				RETURN
				    MINRANK
			formatString: 0.0%;-0.0%;0.0%
			displayFolder: 03_销售金额_贡献_组织
			lineageTag: 0f5fbf0a-93ef-4b0e-a558-0e6a31673c6b

			changedProperty = FormatString

		measure 0303_销售金额_贡献_组织_省简称_大区color =
				
				VAR DQ =
				    CALCULATE ( SUM ( 'D00_大区表'[F_01_大区ID] ), 'D01_省份表' )
				VAR TABLE0 =
				    FILTER ( 'T70_主题颜色', [ID] = DQ )
				VAR COLOR =
				    CONCATENATEX ( TABLE0, [颜色值] )
				RETURN
				    COLOR
			displayFolder: 03_销售金额_贡献_组织
			lineageTag: 43d244a6-82d7-45af-9458-d0dd00a2f8e5

			changedProperty = FormatString

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 0400_销售金额_贡献_产品_分类_% =
				
				VAR FZ = [0001_销售金额_单位_D_]
				VAR FM =
				    CALCULATE ( [0001_销售金额_单位_D_], ALL ( 'T00_产品表'[F_02_产品分类] ) )
				VAR P =
				    DIVIDE ( FZ, FM, BLANK () )
				RETURN
