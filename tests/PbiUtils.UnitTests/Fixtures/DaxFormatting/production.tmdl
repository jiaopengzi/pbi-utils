		measure 安全库存 =
				
				/*
				说明：因理想为标准正太分布，安全库存仅作为参考点，需要加入业务的理解。
				SS= z * SQRT( σd^2* μL + σL^2 * μd^2 )
				其中
				SS：安全库存（Safe Stock）
				z : 服务水平系数，服务水平（现货率）为0.95，在标准正太分布下对应的z=1.65。
				L : 采购提前期
				μL: 平均提前期
				σL: 提前期L的标准差
				d : 日出库量
				μd: 平均日出库量
				σd: 日出库量d的标准差
				*/
				1
			displayFolder: 08_产品数量_库存
			lineageTag: 988a3cf2-fd0a-4bf2-821f-b2af58a966d4

			annotation PBI_FormatHint = {"isGeneralNumber":true}
